# Formbricks Studio Configuration
# Copy this file to .env and customize

# Web UI port
PORT=23457

# Flask debug mode (set to 1 for development)
FLASK_DEBUG=0

# Session secret key (auto-generated if not set)
# SECRET_KEY=your-secret-key-here

# Default Formbricks connection (used as fallback for all environments)
FORMBRICKS_BASE_URL=https://app.formbricks.com
FORMBRICKS_API_KEY=fbk_YOUR_API_KEY

# Optional: path to config file (default: auto-detect config.toml / config.json)
# FORMBRICKS_CONFIG=/path/to/config.toml

# Optional: custom brand name for the web UI
# FORMBRICKS_STUDIO_BRAND=Lazy

# Web UI credentials (if set, skip auth.json setup — just use these)
# FORMBRICKS_USERNAME=admin
# FORMBRICKS_PASSWORD=your-password
